{
  // Default settings, copied to %LOCALAPPDATA%\EdgePanel\config.json on first save.
  // Edit them from the tray icon > Settings.

  // How the Edge is found. The friendly name comes from the monitor's EDID.
  "monitor": {
    "nameContains": "XENEON EDGE",
    "fallbackWidth": 2560,
    "fallbackHeight": 720
  },

  "mouseGuard": true,
  "evictWindows": true,
  "noActivate": true,
  "sensorIntervalMs": 1000,
  "devTools": false,

  // Left to right. "size" is the relative width of each widget.
  "widgets": [
    { "type": "clock", "enabled": true, "size": 1.3 },
    { "type": "cpu", "enabled": true, "size": 0.8 },
    { "type": "gpu", "enabled": true, "size": 0.8 },
    { "type": "ram", "enabled": true, "size": 0.8 },
    { "type": "media", "enabled": true, "size": 1.7 },
    { "type": "shortcuts", "enabled": true, "size": 1.6 }
  ],

  "shortcutColumns": 3,

  // "target" is anything Windows can open: exe path, URL or URI scheme.
  "shortcuts": [
    { "label": "Spotify", "icon": "music", "target": "spotify:" },
    { "label": "Discord", "icon": "chat", "target": "discord:" },
    { "label": "Steam", "icon": "game", "target": "steam://open/main" },
    { "label": "Calculator", "icon": "calc", "target": "calc.exe" },
    { "label": "Task Manager", "icon": "chart", "target": "taskmgr.exe" },
    { "label": "Browser", "icon": "globe", "target": "https://www.google.com" }
  ]
}
